# --- Kite Connect (reuse sos-kite credentials) ---
KITE_API_KEY=your_api_key
KITE_ACCESS_TOKEN=refresh_daily_before_0900
KITE_HISTORICAL=false          # set true only if historical data add-on is active

# --- Telegram ---
TG_BOT_TOKEN=your_bot_token
TG_CHAT_ID=your_chat_id

# --- Database (Railway Postgres plugin sets this automatically; else SQLite fallback) ---
# DATABASE_URL=postgresql://...

# --- Mode ---
PAPER_MODE=true                # keep true for first 15 sessions minimum

# --- Thresholds (v1.3 defaults; do not loosen without backtest evidence) ---
RVOL_MIN=2.5
OI_DELTA_MIN=8
MAX_ALERTS_PER_DAY=3
UNIVERSE_SIZE=40
WATCHLIST_SIZE=8
MOMENTUM_12W_MIN=30            # long pool: stock up >=30% in 12 weeks
MOMENTUM_12W_SHORT=-20         # short pool: stock down <=-20% in 12 weeks
RR_MIN=3.0                     # minimum room-to-stop ratio
RR_HOLD_T2=5.0                 # required ratio to hold for T2
ADR_STOP_MAX_PCT=120           # stop distance must be < 120% of 21-day ADR
GAP_SKIP_PCT=5.0               # skip gaps larger than this (exhaustion)
KILL_SWITCH_SL_COUNT=2         # SL hits per day before scanner mutes
NO_NEW_ALERTS_AFTER=14:00
HARD_EXIT_TIME=14:45
